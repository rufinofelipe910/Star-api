const axios = require('axios');

const BASE = 'https://rest.apicausas.xyz';
const ENDPOINT = '/api/v1/buscadores/lirycs';
const APIKEY = 'causa-b0ec2c842e895e70';

module.exports = function(app) {
  app.get('/search/lyrics', async (req, res) => {
    try {
      const { q } = req.query;
      if (!q) return res.status(400).json({ status: false, error: 'Query is required' });

      const { data } = await axios.get(BASE + ENDPOINT, {
        params: { apikey: APIKEY, q }
      });

      res.status(200).json({ status: true, result: data });
    } catch (error) {
      res.status(500).json({ status: false, error: error.message });
    }
  });
};